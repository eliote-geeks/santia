# General
TZ=Africa/Douala

# Frontend build (public URL for the backend)
PUBLIC_BACKEND_URL=http://localhost:8001
PUBLIC_OPENIM_WEB_URL=http://localhost:11001
PUBLIC_OPENIM_API_URL=
PUBLIC_OPENIM_CHAT_URL=
PUBLIC_OPENIM_WS_URL=

# Backend
DB_NAME=santia
CORS_ORIGINS=http://localhost:3000
AUTH_SECRET=change_me
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=10080
DEFAULT_DOCTOR_PASSWORD=

# Mongo
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me

# OpenEMR API (backend integration)
# When using docker compose, the backend should reach OpenEMR via http://openemr
OPENEMR_BASE_URL=http://openemr
OPENEMR_SITE_ADDR=http://localhost:8080
OPENEMR_REDIRECT_URI=http://localhost:8080
OPENEMR_SITE=default
OPENEMR_CLIENT_ID=santia-local
OPENEMR_CLIENT_SECRET=
OPENEMR_USERNAME=admin
OPENEMR_PASSWORD=admin123
OPENEMR_SCOPE=openid api:oemr user/patient.read user/patient.write user/appointment.write
OPENEMR_VERIFY_TLS=false
OPENEMR_COUNTRY_CODE=CM
OPENEMR_APPT_FACILITY_ID=3
OPENEMR_APPT_BILLING_LOCATION_ID=3
OPENEMR_PROVIDER_ID=1
OPENEMR_APPT_CATEGORY_ID=10
OPENEMR_APPT_DURATION=900
OPENEMR_APPT_STATUS=-
OPENEMR_APPT_TITLE=Teleconsultation

# OpenEMR container
OPENEMR_PORT=8080
OPENEMR_MYSQL_ROOT_PASSWORD=local_root_pass
OPENEMR_MYSQL_PASSWORD=local_openemr_pass
OPENEMR_ADMIN_PASSWORD=admin123
OPENEMR_DB_HOST=openemr-mysql
OPENEMR_DB_PORT=3306
OPENEMR_DB_USER=root
OPENEMR_DB_PASSWORD=local_root_pass
OPENEMR_DB_NAME=openemr

# Jitsi (backend integration)
# Use your public URL in production so patients can open the link
JITSI_BASE_URL=http://localhost:8000
JITSI_ROOM_PREFIX=santia

# Jitsi containers
JITSI_HTTP_PORT=8000
JITSI_JVB_PORT=10000
JITSI_PUBLIC_URL=http://localhost:8000
JITSI_XMPP_DOMAIN=meet.local
JITSI_ADVERTISE_IP=127.0.0.1
JITSI_JICOFO_COMPONENT_SECRET=change_me
JITSI_JICOFO_AUTH_PASSWORD=change_me
JITSI_JVB_AUTH_PASSWORD=change_me

# OpenIM (messagerie)
OPENIM_DATA_DIR=./openim-data

OPENIM_MONGO_IMAGE=mongo:7.0
OPENIM_REDIS_IMAGE=redis:7.0.0
OPENIM_KAFKA_IMAGE=bitnamilegacy/kafka:3.5.1
OPENIM_MINIO_IMAGE=minio/minio:RELEASE.2024-01-11T07-46-16Z
OPENIM_ETCD_IMAGE=bitnamilegacy/etcd:3.5.13
OPENIM_SERVER_IMAGE=openim/openim-server:v3.8.3-patch.9
OPENIM_CHAT_IMAGE=openim/openim-chat:v1.8.4-patch.2
OPENIM_WEB_IMAGE=openim/openim-web-front:release-v3.8.3

OPENIM_MONGO_ROOT_USER=root
OPENIM_MONGO_ROOT_PASSWORD=openIM123
OPENIM_MONGO_DATABASE=openim_v3
OPENIM_MONGO_USERNAME=openIM
OPENIM_MONGO_PASSWORD=openIM123
OPENIM_MONGO_ADDRESS=openim-mongo:27017

OPENIM_REDIS_ADDRESS=openim-redis:6379
OPENIM_REDIS_PASSWORD=openIM123

OPENIM_ETCD_ADDRESS=openim-etcd:2379
OPENIM_ETCD_USERNAME=
OPENIM_ETCD_PASSWORD=

OPENIM_KAFKA_ADDRESS=openim-kafka:9094
OPENIM_KAFKA_USERNAME=
OPENIM_KAFKA_PASSWORD=

OPENIM_MINIO_INTERNAL_ADDRESS=openim-minio:9000
OPENIM_MINIO_EXTERNAL_ADDRESS=http://localhost:10005
OPENIM_MINIO_ACCESS_KEY_ID=root
OPENIM_MINIO_SECRET_ACCESS_KEY=openIM123
OPENIM_MINIO_PORT=10005
OPENIM_MINIO_CONSOLE_PORT=10004

OPENIM_SECRET=openIM123
OPENIM_LOG_IS_STDOUT=true
OPENIM_LOG_LEVEL=3

OPENIM_MSG_GATEWAY_PORT=10001
OPENIM_API_PORT=10002
OPENIM_CHAT_API_PORT=10008
OPENIM_ADMIN_API_PORT=10009
OPENIM_WEB_PORT=11001

OPENIM_API_URL=http://openim-server:10002

# OpenIM SSO (backend)
OPENIM_CHAT_BASE_URL=http://openim-chat:10008
OPENIM_ADMIN_BASE_URL=http://openim-chat:10009
OPENIM_ADMIN_ACCOUNT=chatAdmin
OPENIM_ADMIN_PASSWORD=
OPENIM_ADMIN_VERSION=1.0
OPENIM_PLATFORM_ID=5

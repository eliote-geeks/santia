FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile

COPY frontend/ ./

ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ARG REACT_APP_OPENIM_WEB_URL
ARG REACT_APP_OPENIM_API_URL
ARG REACT_APP_OPENIM_CHAT_URL
ARG REACT_APP_OPENIM_WS_URL
ENV REACT_APP_OPENIM_WEB_URL=$REACT_APP_OPENIM_WEB_URL
ENV REACT_APP_OPENIM_API_URL=$REACT_APP_OPENIM_API_URL
ENV REACT_APP_OPENIM_CHAT_URL=$REACT_APP_OPENIM_CHAT_URL
ENV REACT_APP_OPENIM_WS_URL=$REACT_APP_OPENIM_WS_URL

RUN yarn build

FROM nginx:alpine

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
